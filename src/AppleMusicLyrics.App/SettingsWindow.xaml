<Window x:Class="AppleMusicLyrics.App.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:AppleMusicLyrics.App.Localization" Title="{loc:Loc Settings.Title}" Width="740" Height="720" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI, Microsoft YaHei UI" Foreground="White" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" Background="#0B0C10">
  <Window.Resources>
    <!-- Palette -->
    <Color x:Key="AccentColor">#FF3B60</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FF3B60" />
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Offset="0" Color="#FF4F7E" />
      <GradientStop Offset="1" Color="#FF2D55" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBrush" Color="#16181F" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#262B35" />
    <SolidColorBrush x:Key="InputBrush" Color="#0E1015" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2E3540" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2B313B" />
    <SolidColorBrush x:Key="KnobBrush" Color="#B7BEC9" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F6FB" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#969FAD" />
    <!-- Section + label typography -->
    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="Margin" Value="2,0,0,16" />
    </Style>
    <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ValueLabelStyle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Card -->
    <Style x:Key="CardStyle" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource CardBrush}" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="Margin" Value="0,0,0,14" />
      <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- Toggle switch (CheckBox) -->
    <Style x:Key="ToggleStyle" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontSize" Value="13.5" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Border Background="Transparent" Padding="0,9">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter VerticalAlignment="Center" />
                <Border x:Name="Track" Grid.Column="1" Width="44" Height="26" CornerRadius="13" Background="{StaticResource TrackBrush}" VerticalAlignment="Center">
                  <Ellipse x:Name="Knob" Width="18" Height="18" Margin="4,0,0,0" HorizontalAlignment="Left" Fill="{StaticResource KnobBrush}" />
                </Border>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentGradient}" />
                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                <Setter TargetName="Knob" Property="Fill" Value="White" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Track" Property="Opacity" Value="0.82" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Slider -->
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Grid>
              <Ellipse Width="18" Height="18" Fill="White" />
              <Ellipse Width="18" Height="18" Fill="{StaticResource AccentBrush}" Opacity="0" x:Name="Glow" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
      <Setter Property="Height" Value="26" />
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Border Height="6" CornerRadius="3" Background="{StaticResource TrackBrush}" VerticalAlignment="Center" />
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource AccentGradient}" VerticalAlignment="Center" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource SliderThumbStyle}" />
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- TextBox -->
    <Style x:Key="EditorTextBoxStyle" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Bd" CornerRadius="9" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Padding="11,8">
              <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- ComboBox -->
    <ControlTemplate x:Key="ComboToggleTemplate" TargetType="ToggleButton">
      <Border x:Name="ArrowBorder" Background="Transparent" CornerRadius="0,8,8,0" Padding="10">
        <Path Width="9" Height="5" Stretch="Fill" Fill="{StaticResource SecondaryTextBrush}" Data="M0,0 L4,4 L8,0 Z" />
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter TargetName="ArrowBorder" Property="Background" Value="#242B35" />
        </Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="EditorComboBoxItemStyle" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#232A34" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EditorComboBoxStyle" TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="MinHeight" Value="38" />
      <Setter Property="IsEditable" Value="True" />
      <Setter Property="ItemContainerStyle" Value="{StaticResource EditorComboBoxItemStyle}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="34" />
              </Grid.ColumnDefinitions>
              <Border x:Name="ComboBorder" Grid.ColumnSpan="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="9" />
              <ContentPresenter x:Name="SelectionContent" Grid.Column="0" Margin="11,8,2,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
              <TextBox x:Name="PART_EditableTextBox" Grid.Column="0" Margin="10,6,1,6" Visibility="Collapsed" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" CaretBrush="White" SelectionBrush="{StaticResource AccentBrush}" IsReadOnly="{TemplateBinding IsReadOnly}" Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
              <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press" Template="{StaticResource ComboToggleTemplate}" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
              <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
                <Border Margin="0,5,0,0" MaxHeight="260" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#14171D" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="6">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                    <ItemsPresenter />
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEditable" Value="True">
                <Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Buttons -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinWidth" Value="92" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Background="#1E232B" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#272D37" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#171B22" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="MinWidth" Value="100" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="10" Background="{StaticResource AccentGradient}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.9" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.78" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="ActionButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="#222831" Padding="12,8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#2B323D" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Scrollbar -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="4" Background="#39414D" Margin="2,0" />
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- Helper: a label + value row above a slider -->
    <Style x:Key="SliderHeaderGridStyle" TargetType="Grid">
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
      <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabBorder" Background="Transparent" CornerRadius="9" Padding="12,11" Margin="2,0">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="#252C37" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentGradient}" />
                <Setter Property="Foreground" Value="White" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="TabBorder" Property="BorderBrush" Value="White" />
                <Setter TargetName="TabBorder" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#10141B" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="4" Margin="0,0,0,14">
                <UniformGrid Rows="1" IsItemsHost="True" />
              </Border>
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Offset="0" Color="#0C0E13" />
        <GradientStop Offset="1" Color="#121620" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid Margin="22">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Margin="2,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" Text="{loc:Loc Settings.Title}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
          <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,10,0" Text="{loc:Loc Settings.Language}" />
          <ComboBox x:Name="LanguageComboBox" Width="145" Style="{StaticResource EditorComboBoxStyle}" IsEditable="False" DisplayMemberPath="NativeName" SelectedValuePath="Code" SelectionChanged="LanguageComboBox_OnSelectionChanged" />
        </StackPanel>
      </Grid>
      <TabControl x:Name="SettingsTabs" Grid.Row="1" Style="{StaticResource SettingsTabControlStyle}" SelectedIndex="0" SelectionChanged="SettingsTabs_OnSelectionChanged">
        <TabItem x:Name="AppearanceTab" Header="{loc:Loc Settings.Tab.Appearance}" Style="{StaticResource SettingsTabItemStyle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Original}" />
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.LatinFont}" Margin="0,0,0,7" />
                    <TextBlock Grid.Column="2" Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.ChineseFont}" Margin="0,0,0,7" />
                    <ComboBox x:Name="FontFamilyComboBox" Grid.Row="1" Style="{StaticResource EditorComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" DisplayMemberPath="DisplayName" SelectedValuePath="CanonicalName" TextSearch.TextPath="DisplayName" SelectionChanged="FontChoice_OnChanged" ToolTip="{loc:Loc Settings.ToolTip.Font}" />
                    <ComboBox x:Name="ChineseFontFamilyComboBox" Grid.Row="1" Grid.Column="2" Style="{StaticResource EditorComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" DisplayMemberPath="DisplayName" SelectedValuePath="CanonicalName" TextSearch.TextPath="DisplayName" SelectionChanged="FontChoice_OnChanged" ToolTip="{loc:Loc Settings.ToolTip.ChineseFont}" />
                  </Grid>
                  <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,16">
                    <StackPanel>
                      <TextBlock x:Name="FontPreviewText" Text="{loc:Loc Settings.Preview.Main}" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" />
                      <TextBlock x:Name="FontPreviewContextText" Text="{loc:Loc Settings.Preview.Context}" FontSize="18" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                  </Border>
                  <Grid Style="{StaticResource SliderHeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.CurrentSize}" />
                    <TextBlock x:Name="MaxCurrentFontValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="MaxCurrentFontSlider" Style="{StaticResource ModernSliderStyle}" Minimum="24" Maximum="72" TickFrequency="1" Value="38" ValueChanged="SliderValueChanged" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}" Margin="0,16,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.ContextSize}" />
                    <TextBlock x:Name="ContextFontValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="ContextFontSlider" Style="{StaticResource ModernSliderStyle}" Minimum="12" Maximum="36" TickFrequency="1" Value="24" ValueChanged="SliderValueChanged" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Translation}" />
                  <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.TranslationFont}" Margin="0,0,0,7" />
                  <ComboBox x:Name="TranslationFontFamilyComboBox" Style="{StaticResource EditorComboBoxStyle}" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" DisplayMemberPath="DisplayName" SelectedValuePath="CanonicalName" TextSearch.TextPath="DisplayName" SelectionChanged="FontChoice_OnChanged" ToolTip="{loc:Loc Settings.ToolTip.Font}" />
                  <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,14,0,16">
                    <TextBlock x:Name="TranslationFontPreviewText" Text="{loc:Loc Settings.Preview.Main}" FontSize="20" TextWrapping="Wrap" Foreground="{StaticResource SecondaryTextBrush}" />
                  </Border>
                  <Grid Style="{StaticResource SliderHeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.TranslationSize}" />
                    <TextBlock x:Name="TranslationFontSizeValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="TranslationFontSizeSlider" Style="{StaticResource ModernSliderStyle}" Minimum="10" Maximum="48" TickFrequency="1" Value="20" ValueChanged="SliderValueChanged" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Colors}" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.Glow}" />
                    <TextBlock x:Name="GlowOpacityValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="GlowOpacitySlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="1.0" TickFrequency="0.05" Value="0.42" ValueChanged="SliderValueChanged" />
                  <UniformGrid Margin="0,18,0,0" Columns="2">
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" HorizontalAlignment="Left" Text="{loc:Loc Settings.Field.CurrentColor}" />
                      <DockPanel LastChildFill="False">
                        <Border x:Name="CurrentColorPreview" Width="34" Height="34" CornerRadius="9" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" DockPanel.Dock="Left" />
                        <TextBox x:Name="CurrentColorTextBox" Width="86" Margin="10,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource EditorTextBoxStyle}" Text="#FFFFFF" />
                        <Button Content="{loc:Loc Settings.Action.Choose}" Tag="Current" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource ActionButtonStyle}" Click="PickColorButton_OnClick" />
                      </DockPanel>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" HorizontalAlignment="Left" Text="{loc:Loc Settings.Field.ContextColor}" />
                      <DockPanel LastChildFill="False">
                        <Border x:Name="ContextColorPreview" Width="34" Height="34" CornerRadius="9" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" DockPanel.Dock="Left" />
                        <TextBox x:Name="ContextColorTextBox" Width="86" Margin="10,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource EditorTextBoxStyle}" Text="#C8C8C8" />
                        <Button Content="{loc:Loc Settings.Action.Choose}" Tag="Context" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource ActionButtonStyle}" Click="PickColorButton_OnClick" />
                      </DockPanel>
                    </StackPanel>
                  </UniformGrid>
                  <UniformGrid Margin="0,16,0,0" Columns="2">
                    <StackPanel Margin="0,0,8,0">
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" HorizontalAlignment="Left" Text="{loc:Loc Settings.Field.PausedColor}" />
                      <DockPanel LastChildFill="False">
                        <Border x:Name="PausedColorPreview" Width="34" Height="34" CornerRadius="9" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" DockPanel.Dock="Left" />
                        <TextBox x:Name="PausedColorTextBox" Width="86" Margin="10,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource EditorTextBoxStyle}" Text="#AAAAAA" />
                        <Button Content="{loc:Loc Settings.Action.Choose}" Tag="Paused" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource ActionButtonStyle}" Click="PickColorButton_OnClick" />
                      </DockPanel>
                    </StackPanel>
                    <StackPanel Margin="8,0,0,0">
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Margin="0,0,0,7" HorizontalAlignment="Left" Text="{loc:Loc Settings.Field.GlowColor}" />
                      <DockPanel LastChildFill="False">
                        <Border x:Name="GlowColorPreview" Width="34" Height="34" CornerRadius="9" BorderBrush="{StaticResource InputBorderBrush}" BorderThickness="1" DockPanel.Dock="Left" />
                        <TextBox x:Name="GlowColorTextBox" Width="86" Margin="10,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource EditorTextBoxStyle}" Text="#FFFFFF" />
                        <Button Content="{loc:Loc Settings.Action.Choose}" Tag="Glow" Margin="8,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Left" Style="{StaticResource ActionButtonStyle}" Click="PickColorButton_OnClick" />
                      </DockPanel>
                    </StackPanel>
                  </UniformGrid>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="LyricsTab" Header="{loc:Loc Settings.Tab.Lyrics}" Style="{StaticResource SettingsTabItemStyle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.LyricFeatures}" />
                  <CheckBox Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.WordHighlight}" ToolTip="{loc:Loc Settings.ToolTip.WordTiming}" IsChecked="{Binding Settings.WordHighlightEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                  <CheckBox Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.Translation}" ToolTip="{loc:Loc Settings.ToolTip.Translation}" IsChecked="{Binding Settings.ShowTranslation, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Timing}" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.LyricsOffset}" />
                    <TextBlock x:Name="LyricsOffsetValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <!-- The clock no longer adds a guessed forward push of its own, so the useful range
                   for this hand-tuned value sits about half a second higher than it used to. -->
                  <Slider x:Name="LyricsOffsetSlider" Style="{StaticResource ModernSliderStyle}" Minimum="-0.20" Maximum="1.60" TickFrequency="0.02" Value="0.78" ValueChanged="SliderValueChanged" />
                  <CheckBox Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.NativeOffset}" ToolTip="{loc:Loc Settings.ToolTip.NativeOffset}" IsChecked="{Binding Settings.ApplyNativeLyricOffset, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="WindowTab" Header="{loc:Loc Settings.Tab.Window}" Style="{StaticResource SettingsTabItemStyle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Layout}" />
                  <CheckBox x:Name="PureModeCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.PureMode}" />
                  <CheckBox x:Name="ClickThroughCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.ClickThrough}" />
                  <CheckBox x:Name="SingleLineModeCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.SingleLine}" Checked="LayoutModeCheckBox_OnChanged" Unchecked="LayoutModeCheckBox_OnChanged" />
                  <CheckBox x:Name="TwoLineModeCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.TwoLine}" Checked="LayoutModeCheckBox_OnChanged" Unchecked="LayoutModeCheckBox_OnChanged" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Opacity}" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.OverlayOpacity}" />
                    <TextBlock x:Name="OverlayOpacityValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="OverlayOpacitySlider" Style="{StaticResource ModernSliderStyle}" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" Value="1.0" ValueChanged="SliderValueChanged" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}" Margin="0,16,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.DragOpacity}" />
                    <TextBlock x:Name="PureModeDragOpacityValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="PureModeDragOpacitySlider" Style="{StaticResource ModernSliderStyle}" Minimum="0.2" Maximum="1.0" TickFrequency="0.05" Value="0.8" ValueChanged="SliderValueChanged" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}" Margin="0,16,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.BackgroundOpacity}" />
                    <TextBlock x:Name="BackgroundAlphaValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="BackgroundAlphaSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="100" TickFrequency="2" Value="78" ValueChanged="SliderValueChanged" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="InteractionTab" Header="{loc:Loc Settings.Tab.Interaction}" Style="{StaticResource SettingsTabItemStyle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Fade}" />
                  <CheckBox x:Name="AutoHideCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.AutoHide}" />
                  <CheckBox x:Name="FadeWhenPausedCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.FadeWhenPaused}" />
                  <CheckBox x:Name="HoverFadeCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.HoverFade}" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}" Margin="0,12,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.FadeDuration}" />
                    <TextBlock x:Name="HoverFadeDurationValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="HoverFadeDurationSlider" Style="{StaticResource ModernSliderStyle}" Minimum="0.05" Maximum="1.0" TickFrequency="0.05" Value="0.30" ValueChanged="SliderValueChanged" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}" Margin="0,16,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.HoverOpacity}" />
                    <TextBlock x:Name="HoverFadeMinOpacityValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="HoverFadeMinOpacitySlider" Style="{StaticResource ModernSliderStyle}" Minimum="0" Maximum="0.5" TickFrequency="0.05" Value="0.10" ValueChanged="SliderValueChanged" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem x:Name="AdvancedTab" Header="{loc:Loc Settings.Tab.Advanced}" Style="{StaticResource SettingsTabItemStyle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
            <StackPanel>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Online}" />
                  <CheckBox Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.Catalog}" ToolTip="{loc:Loc Settings.ToolTip.Restart}" IsChecked="{Binding Settings.CatalogLookupEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                  <CheckBox Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.Online}" ToolTip="{loc:Loc Settings.ToolTip.Restart}" IsChecked="{Binding Settings.ExternalLyricsEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Cache}" />
                  <CheckBox x:Name="PersistExternalLyricsCacheCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.PersistCache}" IsChecked="{Binding Settings.PersistExternalLyricsCache, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                  <Grid Style="{StaticResource SliderHeaderGridStyle}" Margin="0,12,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.CacheCapacity}" />
                    <TextBlock x:Name="ExternalLyricsCacheMaxMegabytesValueText" Grid.Column="1" Style="{StaticResource ValueLabelStyle}" />
                  </Grid>
                  <Slider x:Name="ExternalLyricsCacheMaxMegabytesSlider" Style="{StaticResource ModernSliderStyle}" Minimum="1" Maximum="1024" TickFrequency="1" SmallChange="1" LargeChange="64" Value="64" IsSnapToTickEnabled="True" ValueChanged="SliderValueChanged" />
                  <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource FieldLabelStyle}" Text="{loc:Loc Settings.Field.CacheUsage}" />
                      <TextBlock x:Name="ExternalLyricsCacheUsageValueText" Foreground="{StaticResource PrimaryTextBrush}" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,0" />
                    </StackPanel>
                    <Button x:Name="ClearExternalLyricsCacheButton" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Content="{loc:Loc Settings.Action.ClearCache}" Style="{StaticResource GhostButtonStyle}" Click="ClearExternalLyricsCacheButton_OnClick" />
                  </Grid>
                  <TextBlock x:Name="ExternalLyricsCacheStatusText" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                  <TextBlock Style="{StaticResource SectionTitleStyle}" Text="{loc:Loc Settings.Section.Diagnostics}" />
                  <CheckBox Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.NonApple}" ToolTip="{loc:Loc Settings.ToolTip.NonApple}" IsChecked="{Binding Settings.AllowNonAppleMediaSessions, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                  <CheckBox Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.LowConfidence}" ToolTip="{loc:Loc Settings.ToolTip.LowConfidence}" IsChecked="{Binding Settings.AllowLowConfidenceLyrics, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                  <CheckBox x:Name="ShowDebugPanelCheckBox" Style="{StaticResource ToggleStyle}" Content="{loc:Loc Settings.Toggle.Debug}" />
                  <Button x:Name="OpenDiagnosticsButton" Content="{loc:Loc Diagnostics.Open}" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OpenDiagnosticsButton_OnClick" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>
      <DockPanel Grid.Row="2" Margin="0,18,0,0" LastChildFill="False">
        <Button x:Name="ApplyButton" Content="{loc:Loc Settings.Action.Apply}" DockPanel.Dock="Left" Style="{StaticResource GhostButtonStyle}" Click="ApplyButton_OnClick" />
        <Button x:Name="CancelButton" Content="{loc:Loc Settings.Action.Cancel}" DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource GhostButtonStyle}" IsCancel="True" Click="CancelButton_OnClick" />
        <Button x:Name="SaveButton" Content="{loc:Loc Settings.Action.Save}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButtonStyle}" Click="SaveButton_OnClick" IsDefault="True" />
      </DockPanel>
    </Grid>
  </Border>
</Window>
