<Window x:Class="AppleMusicLyrics.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:AppleMusicLyrics.App.Localization"
        Title="Apple Music Lyrics"
        Width="720"
        Height="240"
        MinWidth="320"
        MinHeight="140"
        SizeToContent="Manual"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
  <Window.ContextMenu>
    <ContextMenu Opened="LyricsContextMenu_OnOpened">
      <MenuItem x:Name="RefreshLyricsMenuItem" Header="{loc:Loc Lyrics.Menu.Rescan}" Click="RefreshLyricsMenuItem_OnClick" />
      <MenuItem x:Name="ChooseLyricsMenuItem" Header="{loc:Loc Lyrics.Menu.Choose}" Click="ChooseLyricsMenuItem_OnClick" />
    </ContextMenu>
  </Window.ContextMenu>
  <Grid>
    <Grid.Resources>
      <Style TargetType="{x:Type primitives:Thumb}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type primitives:Thumb}">
              <Border Background="Transparent" />
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid x:Name="ResizeLayer"
          Margin="8"
          Panel.ZIndex="10"
          Visibility="Visible">
      <primitives:Thumb HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Height="12"
                        Background="Transparent"
                        Cursor="SizeNS"
                        Tag="Top"
                        PreviewMouseLeftButtonDown="ResizeThumb_OnPreviewMouseLeftButtonDown" />
      <primitives:Thumb HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Height="12"
                        Background="Transparent"
                        Cursor="SizeNS"
                        Tag="Bottom"
                        PreviewMouseLeftButtonDown="ResizeThumb_OnPreviewMouseLeftButtonDown" />
      <primitives:Thumb HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Width="12"
                        Background="Transparent"
                        Cursor="SizeWE"
                        Tag="Left"
                        PreviewMouseLeftButtonDown="ResizeThumb_OnPreviewMouseLeftButtonDown" />
      <primitives:Thumb HorizontalAlignment="Right"
                        VerticalAlignment="Stretch"
                        Width="12"
                        Background="Transparent"
                        Cursor="SizeWE"
                        Tag="Right"
                        PreviewMouseLeftButtonDown="ResizeThumb_OnPreviewMouseLeftButtonDown" />

      <primitives:Thumb HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Width="18"
                        Height="18"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        Tag="TopLeft"
                        PreviewMouseLeftButtonDown="ResizeThumb_OnPreviewMouseLeftButtonDown" />
      <primitives:Thumb HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="18"
                        Height="18"
                        Background="Transparent"
                        Cursor="SizeNESW"
                        Tag="TopRight"
                        PreviewMouseLeftButtonDown="ResizeThumb_OnPreviewMouseLeftButtonDown" />
      <primitives:Thumb HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Width="18"
                        Height="18"
                        Background="Transparent"
                        Cursor="SizeNESW"
                        Tag="BottomLeft"
                        PreviewMouseLeftButtonDown="ResizeThumb_OnPreviewMouseLeftButtonDown" />
      <primitives:Thumb HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Width="18"
                        Height="18"
                        Background="Transparent"
                        Cursor="SizeNWSE"
                        Tag="BottomRight"
                        PreviewMouseLeftButtonDown="ResizeThumb_OnPreviewMouseLeftButtonDown" />
    </Grid>

    <!-- The visible card. Kept separate from ShellBorder so Pure Mode can animate the card's
         bounds inside a fixed-size window instead of resizing the layered HWND every frame. -->
    <Border x:Name="ShellBackdrop"
            Margin="14"
            CornerRadius="16"
            Background="#C8141416"
            IsHitTestVisible="False" />

    <Border x:Name="ShellBorder"
            Margin="14"
            Padding="12"
            CornerRadius="16"
            Background="Transparent"
            MouseLeftButtonDown="ShellBorder_OnMouseLeftButtonDown">
      <Grid x:Name="ContentRoot">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" x:Name="HeaderPanel">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="SubtitleText"
                     FontSize="13"
                     Foreground="#D0D0D0"
                     Opacity="0.9"
                     TextTrimming="CharacterEllipsis"
                     Text="{loc:Loc Player.WaitingSession}" />
          <TextBlock x:Name="StatusText"
                     Grid.Column="1"
                     Margin="12,0,0,0"
                     FontSize="12"
                     Foreground="#CDD2DA"
                     MaxWidth="220"
                     TextWrapping="Wrap"
                     TextAlignment="Right"
                     Text="{loc:Loc Overlay.Idle}" />
        </Grid>

        <Grid x:Name="LyricPanel"
              Grid.Row="1"
              Margin="0,8,0,6">
          <Grid.RowDefinitions>
            <RowDefinition x:Name="PreviousLyricRow" Height="*" />
            <RowDefinition x:Name="CurrentLyricRow" Height="Auto" />
            <RowDefinition x:Name="NextLyricRow" Height="*" />
          </Grid.RowDefinitions>

          <TextBlock x:Name="PreviousLyricText"
                     Grid.Row="0"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     Foreground="#8F9499"
                     FontSize="22"
                     TextWrapping="Wrap"
                     MaxHeight="36"
                     Text="" />

          <StackPanel x:Name="CurrentLyricContainer" Grid.Row="1"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel.Resources>
            <Style x:Key="ActiveLyricStyle" TargetType="TextBlock">
              <Setter Property="Margin" Value="0,4,0,4" />
              <Setter Property="VerticalAlignment" Value="Center" />
              <Setter Property="HorizontalAlignment" Value="Center" />
              <Setter Property="MaxWidth" Value="1200" />
              <Setter Property="TextAlignment" Value="Center" />
              <Setter Property="Foreground" Value="White" />
              <Setter Property="FontSize" Value="40" />
              <Setter Property="FontWeight" Value="SemiBold" />
              <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="AuxiliaryLyricStyle" TargetType="TextBlock">
              <Setter Property="Margin" Value="0,0,0,4" />
              <Setter Property="HorizontalAlignment" Value="Center" />
              <Setter Property="TextAlignment" Value="Center" />
              <Setter Property="Foreground" Value="#C8FFFFFF" />
              <Setter Property="FontSize" Value="21" />
              <Setter Property="TextWrapping" Value="Wrap" />
              <Setter Property="TextTrimming" Value="CharacterEllipsis" />
              <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
              <Setter Property="Visibility" Value="Collapsed" />
            </Style>
          </StackPanel.Resources>
          <TextBlock x:Name="CurrentLyricText"
                     Style="{StaticResource ActiveLyricStyle}"
                     RenderTransformOrigin="0.5,0.5"
                     Text="{loc:Loc Lyrics.PlaceholderWaiting}">
            <TextBlock.RenderTransform>
              <TranslateTransform x:Name="CurrentLyricTransform" />
            </TextBlock.RenderTransform>
            <TextBlock.Effect>
              <DropShadowEffect x:Name="CurrentLyricGlowEffect"
                                BlurRadius="22"
                                ShadowDepth="0"
                                Color="#FFFFFFFF"
                                Opacity="0.38" />
            </TextBlock.Effect>
          </TextBlock>
          <StackPanel x:Name="BackgroundVocalPanel"
                      Opacity="0.72"
                      Visibility="Collapsed" />
          <TextBlock x:Name="RomanizationLyricText"
                     Style="{StaticResource AuxiliaryLyricStyle}" />
          <TextBlock x:Name="TranslationLyricText"
                     Style="{StaticResource AuxiliaryLyricStyle}" />
          <StackPanel x:Name="DuetLyricContainer" Visibility="Collapsed">
            <TextBlock x:Name="DuetLyricText" Style="{StaticResource ActiveLyricStyle}" />
            <StackPanel x:Name="DuetBackgroundVocalPanel" Opacity="0.72" Visibility="Collapsed" />
            <TextBlock x:Name="DuetRomanizationLyricText" Style="{StaticResource AuxiliaryLyricStyle}" />
            <TextBlock x:Name="DuetTranslationLyricText" Style="{StaticResource AuxiliaryLyricStyle}" />
          </StackPanel>
          </StackPanel>

          <TextBlock x:Name="NextLyricText"
                     Grid.Row="2"
                     Margin="0,0,0,0"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     Foreground="#8F9499"
                     FontSize="22"
                     TextWrapping="Wrap"
                     MaxHeight="36"
                     Text="" />
        </Grid>

        <!-- Frozen snapshot of the outgoing lyrics, used to crossfade into the new ones -->
        <Image x:Name="LyricGhostImage"
               Grid.Row="1"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="None"
               IsHitTestVisible="False"
               Visibility="Collapsed">
          <Image.RenderTransform>
            <TranslateTransform x:Name="LyricGhostTransform" />
          </Image.RenderTransform>
        </Image>

        <Grid x:Name="FooterPanel" Grid.Row="2" Margin="0,4,0,0">
          <TextBlock x:Name="PathText"
                     FontSize="11.5"
                     Foreground="#BFC6D0"
                     LineHeight="16"
                     LineStackingStrategy="BlockLineHeight"
                     MinHeight="16"
                     MaxHeight="16"
                     TextWrapping="NoWrap"
                     TextTrimming="CharacterEllipsis"
                     Text="" />
          <TextBlock x:Name="PlayerText"
                     Visibility="Collapsed"
                     Text="{loc:Loc Player.NoSession}" />
          <TextBlock x:Name="TimingText"
                     Visibility="Collapsed"
                     Text="{loc:Loc Runtime.NoClock}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
