<Window x:Class="AppleMusicLyrics.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AppleMusicLyrics.App.Localization"
        Title="{loc:Loc Update.Window.Title}"
        Width="620" Height="460" MinWidth="460" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        Background="#101319" Foreground="#F3F6FB" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#182130" />
      <Setter Property="Padding" Value="12,6" />
    </Style>
  </Window.Resources>
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="HeadlineText" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
    <TextBlock x:Name="StatusText" Grid.Row="1" Foreground="#A8B2C3" TextWrapping="Wrap" Margin="0,0,0,14"
               AutomationProperties.LiveSetting="Polite" />
    <TextBlock x:Name="NotesTitleText" Grid.Row="2" Foreground="#A8B2C3" Margin="0,0,0,6"
               Text="{loc:Loc Update.Notes}" />
    <TextBox x:Name="NotesTextBox" Grid.Row="3" IsReadOnly="True" IsUndoEnabled="False"
             AutomationProperties.Name="{loc:Loc Update.Notes}"
             Background="#171C25" Foreground="#F3F6FB" BorderBrush="#364051"
             TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Padding="10" />
    <ProgressBar x:Name="DownloadProgress" Grid.Row="4" Height="6" Margin="0,14,0,0" Minimum="0" Maximum="1"
                 Visibility="Collapsed" Foreground="#FF2F5F" Background="#2A3140" BorderThickness="0" />
    <DockPanel Grid.Row="5" Margin="0,16,0,0" LastChildFill="False">
      <Button x:Name="ReleasePageButton" DockPanel.Dock="Left" Content="{loc:Loc Update.Action.ReleasePage}"
              Click="ReleasePageButton_OnClick" />
      <Button x:Name="LaterButton" DockPanel.Dock="Right" IsCancel="True" Content="{loc:Loc Update.Action.Later}"
              Click="LaterButton_OnClick" />
      <Button x:Name="SkipButton" DockPanel.Dock="Right" Margin="0,0,8,0" Content="{loc:Loc Update.Action.Skip}"
              Click="SkipButton_OnClick" />
      <Button x:Name="InstallButton" DockPanel.Dock="Right" Margin="0,0,8,0" IsDefault="True"
              Content="{loc:Loc Update.Action.Install}" Click="InstallButton_OnClick" />
    </DockPanel>
  </Grid>
</Window>
